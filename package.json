{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --import ./tests/helpers/register-ts-resolve.mjs --test tests/core.test.mjs tests/rendered-html.test.mjs tests/bidding-contract.test.mjs tests/finder-contract.test.mjs tests/gixen-client.test.mjs tests/finder-notify.test.mjs tests/ebay-finder.test.mjs tests/gemini-vision.test.mjs tests/finder-service.test.mjs tests/finder-routes.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "scheduler:dev": "wrangler dev --config scheduler/wrangler.jsonc",
    "scheduler:deploy": "wrangler deploy --config scheduler/wrangler.jsonc"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "nodemailer": "^9.0.5",
    "openai": "^7.3.0",
    "playwright-core": "^1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
